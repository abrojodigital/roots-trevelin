{
    "name": "roots-trevelin/instituto-ingles",
    "description": "Sistema de administración para Instituto de Inglés con arquitectura MVC",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Roots Trevelin",
            "email": "info@roots-trevelin.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpunit/php-code-coverage": "^9.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "test-unit": "phpunit --testsuite Unit",
        "test-feature": "phpunit --testsuite Feature",
        "test-models": "phpunit --testsuite Models",
        "test-controllers": "phpunit --testsuite Controllers"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
} 